---
/** Yacaré — asoma del agua; de noche se hunde un poco, con luz de luna en el lomo y su reflejo en el agua. */
import Animal from './Animal.astro';
import { url } from '../../lib/site';
---
<div class="yacare-agua">
  <!-- reflejo nocturno en el agua -->
  <img class="reflejo" src={url('animales/yacare-noche.webp')} alt="" loading="lazy" decoding="async" />
  <Animal
    nombre="Yacaré"
    dia="yacare-dia.webp" noche="yacare-noche.webp"
    proporcionDia={4.641} proporcionNoche={4.701} escalaNoche={1}
  />
  <svg class="agua" viewBox="0 0 1200 100" preserveAspectRatio="none" aria-hidden="true">
    <defs>
      <linearGradient id="yc-agua" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" class="a1" />
        <stop offset="1" class="a2" />
      </linearGradient>
    </defs>
    <path fill="url(#yc-agua)" d="M0,16 C80,8 160,24 240,16 C320,8 400,24 480,16 C560,8 640,24 720,16 C800,8 880,24 960,16 C1040,8 1120,24 1200,16 L1200,100 L0,100 Z" />
    <path class="destello" d="M80,40 L240,40 M500,58 L700,58 M900,36 L1060,36" />
    <g class="luna"><path d="M180,30 L330,30 M210,46 L300,46 M600,34 L760,34 M640,52 L720,52 M960,44 L1100,44" /></g>
  </svg>
</div>

<style>
  .yacare-agua { position: relative; padding-bottom: 4%; overflow: hidden; }
  .agua {
    position: absolute; left: 0; bottom: 0; width: 100%; height: 52%;
    -webkit-mask-image: linear-gradient(to right, transparent, #000 18%, #000 82%, transparent);
    mask-image: linear-gradient(to right, transparent, #000 18%, #000 82%, transparent);
  }
  .a1 { stop-color: var(--agua-1); stop-opacity: .92; transition: stop-color 1.4s; }
  .a2 { stop-color: var(--agua-2); transition: stop-color 1.4s; }
  .destello { stroke: var(--papel); stroke-width: 2; stroke-linecap: round; opacity: .45; fill: none; }
  .yacare-agua :global(.animal) { position: relative; z-index: 1; transition: transform 2.8s cubic-bezier(.45, 0, .25, 1); }
  .agua { z-index: 2; }
  :global([data-theme='noche']) .yacare-agua :global(.animal) { transform: translateY(8%); }

  /* noche: luz de luna sobre el lomo para que tenga volumen */
  :global([data-theme='noche']) .yacare-agua :global(.noche img) {
    filter: brightness(1.25) contrast(1.15) saturate(.9)
            drop-shadow(0 -1px 1.5px rgba(205, 225, 215, .38))
            drop-shadow(0 0 10px rgba(150, 190, 175, .18));
  }
  .yacare-agua :global(.noche img) { transition: filter 2.4s ease-in-out; }

  /* reflejo invertido dentro del agua, solo de noche */
  .reflejo {
    position: absolute; left: 0; width: 100%; bottom: 46%; height: auto; z-index: 3;
    transform: scaleY(-.5); transform-origin: 50% 100%;
    opacity: 0; filter: blur(1.5px) brightness(1.6); mix-blend-mode: screen;
    -webkit-mask-image: linear-gradient(to bottom, #000, transparent 70%); mask-image: linear-gradient(to bottom, #000, transparent 70%);
    transition: opacity 2.4s ease-in-out; pointer-events: none;
  }
  :global([data-theme='noche']) .reflejo { opacity: .16; }
  .luna path { stroke: #e8e2cc; stroke-width: 1.6; stroke-linecap: round; fill: none; opacity: 0; transition: opacity 2.4s ease-in-out; }
  :global([data-theme='noche']) .luna path { opacity: .45; }
  @media (prefers-reduced-motion: no-preference) {
    .yacare-agua :global(.animal) { animation: flota 7s ease-in-out infinite; }
    :global([data-theme='noche']) .luna { animation: titila 5s ease-in-out infinite; }
  }
  @keyframes flota { 0%, 100% { translate: 0 0; } 50% { translate: 0 3px; } }
  @keyframes titila { 0%, 100% { opacity: 1; } 50% { opacity: .5; } }
</style>
