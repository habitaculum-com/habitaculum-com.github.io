---
import Base from '../layouts/Base.astro';
import Aguara from '../components/animales/Aguara.astro';
import Yaguarete from '../components/animales/Yaguarete.astro';
import Yacare from '../components/animales/Yacare.astro';
import Juncos from '../components/Juncos.astro';
import Ornamento from '../components/Ornamento.astro';
import TarjetaPost from '../components/TarjetaPost.astro';
import { PORTADA } from '../textos';
import { CATEGORIAS, SITIO, formatearFecha, obtenerPosts, tiempoLectura, url, urlPost } from '../lib/site';

const posts = await obtenerPosts();
const [ultimo, ...resto] = posts;
const recientes = resto.slice(0, 4);
const conteo = Object.fromEntries(Object.keys(CATEGORIAS).map((c) => [c, posts.filter((p) => p.data.categoria === c).length]));
---
<Base>
  <!-- ============ PORTADA ============ -->
  <section class="portada">
    <div class="escenario" aria-hidden="false">
      <div class="cielo">
        <span class="astro-sol"></span>
        <span class="astro-luna"></span>
        <span class="estrellas"></span>
      </div>
      <svg class="horizonte" viewBox="0 0 600 200" preserveAspectRatio="none" aria-hidden="true">
        <path class="lomas" d="M0,120 C80,100 160,110 240,96 C320,84 420,104 600,92 L600,200 L0,200 Z" />
        <path class="laguna" d="M0,150 C120,142 260,152 380,146 C480,141 560,148 600,146 L600,200 L0,200 Z" />
        <path class="brillo" d="M60,160 L180,160 M260,170 L400,170 M440,158 L540,158" />
      </svg>
      <div class="aguara-marco"><Aguara /></div>
      <svg class="pajonal" viewBox="0 0 600 120" preserveAspectRatio="none" aria-hidden="true">
        <path d="M0,120 L0,60 C20,80 30,30 40,70 C50,40 60,20 70,72 C80,50 95,30 100,74 C112,44 120,40 130,76 C140,52 160,30 165,78 C180,48 190,56 200,80 C214,40 228,36 236,82 C250,50 262,46 270,84 C284,52 296,30 304,80 C318,48 332,44 340,82 C352,56 366,34 374,78 C388,50 400,46 410,80 C424,44 438,40 446,78 C460,50 472,48 480,82 C494,40 506,36 514,76 C528,52 540,40 548,74 C560,46 576,40 584,70 C590,60 596,56 600,60 L600,120 Z" />
      </svg>
      <Juncos lado="izq" class="juncos-portada" />
    </div>

    <div class="ultimo">
      <p class="versal saludo">{PORTADA.antetitulo}</p>
      <h1>{SITIO.titulo}</h1>
      <p class="subtitulo">{SITIO.subtitulo}</p>
      <Ornamento />
      {ultimo && (
        <article class="marco ultimo-post">
          <p class="versal etiqueta">{PORTADA.ultimoEscrito}</p>
          <div class="meta">
            <a class="chip" href={url(CATEGORIAS[ultimo.data.categoria].ruta)}>{CATEGORIAS[ultimo.data.categoria].nombre}</a>
            <span>{formatearFecha(ultimo.data.fecha)} · {tiempoLectura(ultimo.body)} min de lectura</span>
          </div>
          <h2><a href={urlPost(ultimo)}>{ultimo.data.titulo}</a></h2>
          <p class="extracto">{ultimo.data.extracto}</p>
          <a class="boton" href={urlPost(ultimo)}>{PORTADA.botonLeer}</a>
        </article>
      )}
      <a class="bajar" href="#recientes">{PORTADA.invitacion} <span aria-hidden="true">↓</span></a>
    </div>
  </section>

  <!-- ============ RECIENTES (el yaguareté acecha desde el borde izquierdo) ============ -->
  <section id="recientes" class="recientes">
    <div class="acecho acecho-izq revelar desde-izq"><Yaguarete /></div>
    <div class="contenedor angosto">
      <p class="versal revelar">{PORTADA.recientesAntetitulo}</p>
      <h2 class="revelar">{PORTADA.recientesTitulo}</h2>
      {recientes.map((p) => <TarjetaPost post={p} />)}
      <div class="botones revelar">
        <a class="boton" href={url('escritos/')}>Escritos</a>
        <a class="boton" href={url('investigaciones/')}>Investigaciones</a>
      </div>
    </div>
  </section>

  <Ornamento />

  <!-- ============ SECCIONES (el yacaré espía desde el borde derecho) ============ -->
  <section class="secciones">
    <div class="contenedor">
      <p class="versal revelar centrado">{PORTADA.seccionesAntetitulo}</p>
      <h2 class="revelar centrado">{PORTADA.seccionesTitulo}</h2>
      <div class="grilla">
        {Object.entries(CATEGORIAS).map(([clave, c]) => (
          <a class="marco categoria revelar" href={url(c.ruta)}>
            <span class="versal">{conteo[clave]} {conteo[clave] === 1 ? 'texto' : 'textos'}</span>
            <h3>{c.nombre}</h3>
            <p>{c.descripcion}</p>
          </a>
        ))}
      </div>
    </div>
    <div class="acecho acecho-der revelar desde-der"><Yacare /></div>
  </section>
</Base>

<style>
  /* ---------- Portada partida en dos mitades ---------- */
  .portada {
    display: grid; grid-template-columns: 1fr 1fr;
    min-height: calc(100vh - 68px); min-height: calc(100svh - 68px);
  }
  .escenario { position: relative; overflow: hidden; border-right: 1px solid var(--linea); }
  .cielo { position: absolute; inset: 0; }
  .astro-sol, .astro-luna {
    position: absolute; top: 12%; right: 16%; width: clamp(90px, 12vw, 150px); aspect-ratio: 1; border-radius: 50%;
    transition: opacity 1.6s ease, transform 1.8s cubic-bezier(.6,0,.2,1);
  }
  .astro-sol { background: radial-gradient(circle at 40% 40%, #f6d58b, #e9a54a 70%); opacity: .55; filter: blur(.5px); }
  .astro-luna { background: radial-gradient(circle at 35% 35%, #f3ecd6, #c9c1a6 70%); box-shadow: 0 0 60px 10px rgba(243, 236, 214, .15); opacity: 0; transform: translateY(40px); }
  .estrellas {
    position: absolute; inset: 0 0 40% 0; opacity: 0; transition: opacity 2s;
    background-image:
      radial-gradient(1.4px 1.4px at 12% 18%, #efe6d2 50%, transparent 51%),
      radial-gradient(1px 1px at 28% 36%, #efe6d2 50%, transparent 51%),
      radial-gradient(1.2px 1.2px at 44% 12%, #efe6d2 50%, transparent 51%),
      radial-gradient(1px 1px at 58% 30%, #efe6d2 50%, transparent 51%),
      radial-gradient(1.6px 1.6px at 70% 48%, #efe6d2 50%, transparent 51%),
      radial-gradient(1px 1px at 86% 8%, #efe6d2 50%, transparent 51%),
      radial-gradient(1.2px 1.2px at 92% 40%, #efe6d2 50%, transparent 51%),
      radial-gradient(1px 1px at 8% 52%, #efe6d2 50%, transparent 51%),
      radial-gradient(1.3px 1.3px at 36% 58%, #efe6d2 50%, transparent 51%);
  }
  :global([data-theme='noche']) .astro-sol { opacity: 0; transform: translateY(60px); }
  :global([data-theme='noche']) .astro-luna { opacity: .95; transform: none; }
  :global([data-theme='noche']) .estrellas { opacity: 1; }

  .horizonte { position: absolute; left: 0; right: 0; bottom: 0; width: 100%; height: 44%; }
  .lomas { fill: var(--verde-2); opacity: .35; transition: fill 1.4s; }
  .laguna { fill: #9cb9ad; opacity: .55; transition: fill 1.4s, opacity 1.4s; }
  :global([data-theme='noche']) .laguna { fill: #1c2e2a; opacity: .9; }
  .brillo { stroke: var(--papel); stroke-width: 1.5; stroke-linecap: round; opacity: .6; }
  .pajonal { position: absolute; left: 0; right: 0; bottom: 0; width: 100%; height: 16%; }
  .pajonal path { fill: var(--vegetacion); opacity: .85; transition: fill 1.4s; }

  .aguara-marco {
    position: absolute; left: 50%; bottom: 5%; transform: translateX(-50%);
    width: min(64%, 56vh); z-index: 1;
  }
  :global(.juncos-portada) { z-index: 2; width: 140px !important; }

  /* ---------- Mitad derecha ---------- */
  .ultimo { display: flex; flex-direction: column; justify-content: center; padding: clamp(2rem, 5vw, 5rem); }
  .saludo { margin-bottom: .3rem; }
  .subtitulo { font-style: italic; color: var(--tinta-suave); font-size: 1.25rem; margin: 0; }
  .ultimo :global(.ornamento) { justify-content: flex-start; margin: 1.6rem 0; }
  .ultimo-post { padding: 2rem 2.2rem; }
  .etiqueta { margin: 0 0 .8rem; font-size: .95rem; }
  .meta { display: flex; flex-wrap: wrap; gap: .4rem 1rem; align-items: baseline; color: var(--tinta-suave); font-size: .95rem; margin-bottom: .6rem; }
  .ultimo-post h2 a { color: var(--tinta); text-decoration: none; }
  .ultimo-post h2 a:hover { color: var(--verde); }
  .extracto { color: var(--tinta-suave); }
  .boton {
    display: inline-block; margin-top: .4rem; padding: .55rem 1.3rem; border: 1px solid var(--verde);
    color: var(--verde); text-decoration: none; font-family: var(--f-versal); font-variant: small-caps;
    letter-spacing: .12em; text-transform: lowercase; transition: background .3s, color .3s;
  }
  .boton:hover { background: var(--verde); color: var(--fondo); }
  .bajar { margin-top: 2.2rem; font-style: italic; color: var(--tinta-suave); text-decoration: none; align-self: flex-start; }
  .bajar span { display: inline-block; }
  @media (prefers-reduced-motion: no-preference) { .bajar span { animation: flotar 2.4s ease-in-out infinite; } }
  @keyframes flotar { 50% { transform: translateY(5px); } }

  /* ---------- Animales al acecho: fuera del flujo, asomando por los bordes ---------- */
  .acecho { position: absolute; pointer-events: none; z-index: 0; }
  .acecho-izq { left: -4%; top: 50%; width: clamp(220px, 24vw, 360px); translate: 0 -50%; }
  .acecho-izq :global(.animal) { transform: scaleX(-1); }
  .acecho-der { right: -6%; bottom: 0; width: clamp(280px, 32vw, 480px); }
  .desde-izq.revelar { transform: translateX(-80px); }
  .desde-der.revelar { transform: translateX(80px); }
  .desde-izq.revelar.visible, .desde-der.revelar.visible { transform: none; }

  /* ---------- Recientes ---------- */
  .recientes { position: relative; padding: 7rem 0 3rem; overflow-x: clip; }
  .angosto { max-width: 720px; position: relative; z-index: 1; }
  .botones { display: flex; gap: 1rem; flex-wrap: wrap; margin-top: 1.8rem; }

  /* ---------- Secciones ---------- */
  .centrado { text-align: center; }
  .secciones { position: relative; padding: 2rem 0 clamp(9rem, 14vw, 13rem); overflow-x: clip; }
  .secciones .contenedor { position: relative; z-index: 1; }
  .grilla { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.4rem; margin-top: 2rem; max-width: 980px; margin-inline: auto; }
  .categoria { padding: 1.8rem 1.6rem; text-decoration: none; color: var(--tinta); transition: transform .4s, background 1.4s; }
  .categoria:hover { transform: translateY(-4px); color: var(--tinta); }
  .categoria h3 { margin: .3rem 0 .5rem; }
  .categoria p { color: var(--tinta-suave); margin: 0; font-size: 1.05rem; }

  @media (max-width: 1180px) {
    .acecho-izq { top: auto; bottom: 0; translate: 0 0; width: clamp(160px, 26vw, 260px); opacity: .9; }
    .recientes { padding-bottom: clamp(8rem, 20vw, 12rem); }
  }
  @media (max-width: 760px) {
    .ultimo { padding: 2rem 1rem 1rem; }
    .ultimo h1 { font-size: 2.6rem; }
    .ultimo-post { padding: 1.4rem 1.3rem; }
    .recientes { padding: 3rem 0 9rem; }
    .acecho-izq { width: 48vw; left: -6%; }
    .secciones { padding: 1rem 0 8rem; }
    .acecho-der { width: 62vw; right: -8%; }
    .categoria { padding: 1.3rem 1.3rem; }
  }
  @media (max-width: 900px) {
    .portada { grid-template-columns: 1fr; }
    .escenario { min-height: 58vh; min-height: 58svh; border-right: 0; border-bottom: 1px solid var(--linea); }
    .aguara-marco { width: min(62%, 320px); }
    .grilla { grid-template-columns: 1fr; }
  }
</style>
